<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Bluetooth. The legacy pair is bounded to API 30 because Android 12 (API 31)
        replaced them with BLUETOOTH_SCAN / BLUETOOTH_CONNECT; leaving them
        unbounded asks every modern user for permissions the app cannot use.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!--
        `neverForLocation` is a promise that this app does not derive the user's
        position from nearby radios, and it is one we keep: positions come from
        this phone's own GPS receiver, never from which Bluetooth devices happen
        to be in range. It also means Android 12+ users are never asked for
        location just to find their key. BleService therefore calls startScan with
        androidUsesFineLocation: false — the two must agree, and previously did
        not.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        Location. Needed for two things, only one of them BLE-related: (1) the
        phone's own GPS, which is what stamps a position on every connect,
        disconnect and ping — it replaced the keyholder's GPS module, which could
        only be read while a link was up and so was unreadable at the one moment
        a position matters; and (2) Android 11 and below gate BLE discovery
        behind fine location. Coarse is declared as well, as the fallback when
        the owner grants approximate location only.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        Location while the app is not on screen — "Allow all the time" in the
        system dialog.

        This is what makes background monitoring worth having. From Android 10
        the two permissions above only work while the app is in front; a
        backgrounded app that asks for a position gets nothing back. Since the
        position stamped on every connect, disconnect and ping is read from this
        phone, and since it is also the only position the keyholder's own screen
        will ever have, that silence meant the log went blank and the board sat
        on "No GPS" the moment the owner switched apps — the exact fault
        reported.

        Requested at runtime, and only when the owner turns background
        monitoring on. Everything else in the app works without it: a refusal
        costs background positions, not the app.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:targetApi="q" />

    <!--
        NEARBY_WIFI_DEVICES, ACCESS_WIFI_STATE and CHANGE_WIFI_STATE were
        declared here for Wi-Fi provisioning — the flow that handed the
        keyholder an SSID and password so it could reach Firebase. That flow is
        gone and so are they. A permission the app no longer exercises is not
        free: it is listed on the Play listing and in the system's permission
        screen, and "this key finder wants to see the networks around you" is a
        question the owner should not have to answer for a feature that does not
        exist.

        INTERNET and ACCESS_NETWORK_STATE stay. They are what the map tiles,
        the reverse-geocoding lookup that turns a position into a place name,
        and the public-address readout on the location card all need.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Audio on this phone, for "press the button on the keyholder and my phone
        rings". Two declarations for one capability because Android 13 split media
        access by type: READ_MEDIA_AUDIO from API 33, the legacy blanket storage
        read below it — hence maxSdkVersion="32", so modern users are not asked
        for a permission the platform no longer honours.

        Worth being precise about what these are for. The picker this app uses is
        the system document picker, which hands back read access to the one file
        the owner tapped and needs no permission at all. These are declared so the
        request the owner expects to see actually appears, and so a device that
        does gate the picker behind them is not left unable to choose a sound. The
        code treats a refusal as non-fatal and carries on to the picker.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Buzzing as well as ringing: a phone under a cushion is found by feel. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        The proximity warning ("your keyholder is moving away") is a notification,
        and from Android 13 posting one needs the user's say-so. This was
        deliberately absent while the app posted nothing; it earns its place now
        that NotificationService exists. Requested at runtime, not at install.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Background running.

        Without a foreground service this app is a cached process, and Android
        reclaims those first when memory is short — which is why leaving the app
        killed the BLE link, the proximity warning and every notification with
        it. The service holds the process open; the main isolate's connection
        and timers then carry on untouched.

        The type is `connectedDevice`, not `dataSync`, and that choice has
        teeth: from Android 15 a dataSync service is stopped after roughly six
        hours in any 24-hour window. A key finder that silently stops watching
        after six hours is worse than one that never offered to. This app is
        genuinely interacting with a connected Bluetooth device, so the accurate
        type is also the one without the cap.

        REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is asked for at runtime and only
        when the owner turns the feature on. It is not requested at install and
        the app works without it — but on phones with a manufacturer battery
        manager on top of stock Android (Xiaomi, Oppo, Vivo, Huawei) it is
        frequently the difference between the service surviving and not.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Restart the monitoring after a reboot, so "like WhatsApp" holds across a
        restart too.

        The plugin's own manifest declares the boot receiver; this is the
        permission it needs to be delivered BOOT_COMPLETED. Whether the service
        actually comes back is still the owner's switch — BackgroundService
        passes autoRunOnBoot the stored preference, so a phone whose owner never
        turned background monitoring on starts nothing.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Bluetooth Low Energy is required, not optional: without it there is no app. -->
    <uses-feature android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!--
        usesCleartextTraffic was true, enabling plaintext HTTP app-wide. Nothing
        here needs it — Firebase speaks HTTPS and the keyholder is reached over
        BLE — and leaving it on in a project whose whole premise is security
        invites an easy question in your viva. False means Android itself blocks
        any accidental plaintext request.
    -->
    <application
        android:label="FindX"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!--
            There was a com.google.android.geo.API_KEY meta-data entry here,
            carrying the literal string "YOUR_GOOGLE_MAPS_API_KEY_HERE". It did
            nothing: there is no google_maps_flutter dependency to read it, so
            the only thing it achieved was to suggest to anyone reading the
            manifest that this build was one key away from having Google Maps,
            which it is not and does not need to be.

            The map is drawn from OpenStreetMap raster tiles (widgets/map_tiles
            .dart) and place names come from Nominatim (services/geocoding_
            service.dart). Neither needs a key, neither bills, and tapping the
            map hands the point to whatever maps app the phone already has via
            a geo: intent — see the <queries> block above.
        -->

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
            The class name is the plugin's and must not be changed — the plugin
            starts this service by name.

            `stopWithTask` is deliberately absent here and set from Dart
            instead (see BackgroundService.configure), because it is the one
            behaviour the owner cares about: swiping the app out of Recents must
            not stop the monitoring. Only the notification's Stop button, the
            Settings toggle, or a reboot ends it.
        -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />
    </application>

    <queries>
        <!--
            Package visibility for url_launcher. From Android 11 an app cannot see
            which other apps can handle an intent unless it declares the intent
            here, and `canLaunchUrl` returns false for everything it cannot see —
            so without this the "open in Google Maps" tap silently does nothing on
            every modern phone.

            The `<data>` elements are not optional decoration. An `<intent>` with
            an action and no data matches only intents that carry no data at all,
            which is never the case for a URI, so the schemes have to be named:
            `geo:` for the map-point intent and `https:` for the universal Maps
            URL used as the fallback.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
    </queries>

</manifest>